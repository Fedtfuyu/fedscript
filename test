local _isHopping=false
local function TryTeleport(placeId, jobId)
    local ok,err=pcall(function()
        if jobId then TeleportService:TeleportToPlaceInstance(placeId, jobId, Player)
        else TeleportService:Teleport(placeId, Player) end
    end)
    if not ok and err then warn("[Teleport] "..tostring(err)) end
    return ok
end

local function HopServer(preferLowPop)
    if _isHopping then return true end
    _isHopping=true
    local placeId=game.PlaceId
    local currentJob=game.JobId
    local url=("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(placeId)
    local tried,cursor=0,nil
    while tried<8 do
        tried+=1
        local fullUrl=url..(cursor and ("&cursor="..cursor) or "")
        local res=nil
        pcall(function() res=request({Url=fullUrl,Method="GET",Headers={["Content-Type"]="application/json"}}) end)
        if res and res.StatusCode==200 then
            local data=nil; pcall(function() data=HttpService:JSONDecode(res.Body) end)
            if data and data.data and #data.data>0 then
                local cands={}
                for _,srv in ipairs(data.data) do
                    if srv.playing<srv.maxPlayers and srv.id~=currentJob then table.insert(cands,srv) end
                end
                if #cands>0 then
                    table.sort(cands,function(a,b) return preferLowPop and (a.playing<b.playing) or (a.playing>b.playing) end)
                    local chosen=cands[1]
                    if chosen and TryTeleport(placeId,chosen.id) then return true end
                end
                cursor=data.nextPageCursor; if not cursor then break end
            else break end
        else break end
    end
    TryTeleport(placeId,nil); return true
end
