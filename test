    local function populateOctree()
        rt.octree:ClearAllNodes(); if not rt.coinContainer then return end
        for _,d in pairs(rt.coinContainer:GetDescendants()) do
            if d:IsA("TouchTransmitter") then
                local coin=d.Parent; if not isCoinTouched(coin) then rt.octree:CreateNode(coin.Position,coin); setupTouchTracking(coin) end
                setupPositionTracking(coin,coin.Position.Y)
            end
        end
        rt.Added=rt.coinContainer.DescendantAdded:Connect(function(d)
            if d:IsA("TouchTransmitter") then local coin=d.Parent; if not isCoinTouched(coin) then rt.octree:CreateNode(coin.Position,coin); setupTouchTracking(coin); setupPositionTracking(coin,coin.Position.Y) end end
        end)
        rt.Removing=rt.coinContainer.DescendantRemoving:Connect(function(d)
            if d:IsA("TouchTransmitter") and d.Parent.Name=="Coin_Server" then local coin=d.Parent; if isCoinTouched(coin) then markCoinAsTouched(coin) end end
        end)
    end
    local function ChangeState(s) CurrentState=s end
    local function IsBagFull() return false end -- full bag đã xử lý ở watcher khác

    local function CollectCoins()
        Working=true
        local map=rt:Map(); if not map then Working=false return end
        rt.coinContainer=map:FindFirstChild("CoinContainer"); if not rt.coinContainer then Working=false return end
        populateOctree()
        while CurrentState==State.Action do
            if IsBagFull() then break end
            if rt:Character()==nil then break end
            local nearest=rt.octree:GetNearest(rt:Character().PrimaryPart.Position,rt.radius,1)[1]
            if nearest then
                local coin=nearest.Object; if not isCoinTouched(coin) then
                    local target=coin.Position; local dur=(rt:Character().PrimaryPart.Position-target).Magnitude/rt.walkspeed
                    moveToPositionSlowly(target,dur); markCoinAsTouched(coin); task.wait(0.2)
                end
            else task.wait(1) end
        end
        AutoFarmCleanUp()
    end
    local function RespawnState()
        rt:GetCharacterLoaded(); task.wait(1)
        if LastPosition==nil then
            local list=rt:GetAlivePlayers()
            if list and list[1] and list[1].Character and list[1].Character.PrimaryPart then LastPosition=list[1].Character:GetPivot() end
        end
        if rt:Character() then rt:GetCharacterLoaded(); if LastPosition then rt:Character():PivotTo(LastPosition) end end
        if not rt.RoundInProgress then ChangeState(State.WaitingForRound) return end
        ChangeState(State.Action)
    end
    local function WaitingForRound() Working=false; repeat task.wait(0.5) until rt.RoundInProgress and rt:CheckIfPlayerWasInARound(); ChangeState(State.Action) end
    local function waitForRoundEnd() Working=false; repeat task.wait(1) until not rt.RoundInProgress; ChangeState(State.WaitingForRound) end
    local function StandStillWait() ChangeState("Nothing"); rt:GetCharacterLoaded(); task.wait(2); ChangeState(State.WaitingForRound) end

    rt.RoleTracker1=rt.player.DescendantAdded:Connect(function(d) if d:IsA("Tool") and d.Name=="Knife" then IsMurderer=true end end)
    if ROUND_TIMER then ROUND_TIMER:GetPropertyChangedSignal("Text"):Connect(function() rt.RoundInProgress=true end) end
    local PLAYER_GUI2=Players.LocalPlayer:WaitForChild("PlayerGui")
    PLAYER_GUI2.ChildAdded:Connect(function(child) if child:IsA("Sound") then rt.RoundInProgress=false; Working=false; ChangeState(State.WaitingForRound) end end)
    rt.UserDied=rt.player.CharacterRemoving:Connect(function()
        local LastText=ROUND_TIMER and ROUND_TIMER.Text or ""
        if IsMurderer then IsMurderer=false; LastPosition=nil; Working=false; rt.RoundInProgress=false; return ChangeState(State.StandStillWait) end
        if not rt.RoundInProgress then IsMurderer=false; LastPosition=nil; Working=false; return ChangeState(State.WaitingForRound) end
        task.wait(2)
        if ROUND_TIMER and LastText==ROUND_TIMER.Text then LastPosition=nil; IsMurderer=false; rt.RoundInProgress=false; Working=false; return ChangeState(State.WaitingForRound) end
        if Working then Working=false; IsMurderer=false; LastPosition=nil; ChangeState(State.RespawnState) end
    end)
    IsMurderer=rt.player.Backpack:FindFirstChild("Knife") and true or false

    task.spawn(function()
        while USE_NEW_TP do
            if CurrentState==State.WaitingForRound then WaitingForRound()
            elseif CurrentState==State.Action then
                CollectCoins()
                if BagIsFull or not rt.RoundInProgress then
                    BagIsFull=false; Working=false
                    pcall(function() rt:Character():FindFirstChildWhichIsA("Humanoid"):ChangeState(Enum.HumanoidStateType.Dead) end)
                    ChangeState(State.WaitingForRoundEnd)
                end
            elseif CurrentState==State.WaitingForRoundEnd then waitForRoundEnd()
            elseif CurrentState==State.RespawnState then RespawnState()
            elseif CurrentState==State.StandStillWait then StandStillWait() end
            task.wait()
        end
    end)
end

-- Inventory check -> BlackScreen xanh lá khi có Godly/Chroma
task.spawn(function()
    repeat task.wait(0.5) until rawget(getgenv(),"_BLACKFRAME")
    local function getWeaponsDB()
        local ok,db=pcall(function() return require(ReplicatedStorage:WaitForChild("Database"):WaitForChild("Sync")) end)
        return ok and db and db.Weapons or nil
    end
    local function hasGodlyOrChromaIn(t,db)
        if type(t)~="table" or type(db)~="table" then return false end
        for k,v in pairs(t) do
            local name=(type(k)=="string" and k) or (type(v)=="table" and (v.ItemName or v.Name))
            if name and db[name] then local m=db[name]; if m and (m.Rarity=="Godly" or m.Chroma) then return true end end
            if type(v)=="table" and hasGodlyOrChromaIn(v,db) then return true end
        end
        return false
    end
    local function inventoryHasGodlyOrChroma()
        local okPD,pd=pcall(function() return require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("ProfileData")) end)
        if not okPD or not pd then return false end
        local db=getWeaponsDB(); if not db then return false end
        return hasGodlyOrChromaIn(pd,db)
    end
    while task.wait(5) do
        local ok,has=pcall(inventoryHasGodlyOrChroma)
        if ok and has then local frame=rawget(getgenv(),"_BLACKFRAME"); if frame then pcall(function() frame.BackgroundColor3=Color3.fromRGB(0,255,0) end) end; break end
    end
end)
