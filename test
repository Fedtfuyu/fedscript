local function CreateFloatPlatform()
    pcall(function()
        local pchar = LocalPlayer.Character
        if not pchar or pchar:FindFirstChild(floatName) then return end
        task.spawn(function()
            local Float = Instance.new("Part")
            Float.Name = floatName
            Float.Parent = pchar
            Float.Transparency = 1
            Float.Size = Vector3.new(2, 0.2, 1.5)
            Float.Anchored = true
            local FloatValue = -2.8
            local root = getRoot(pchar); if not root then return end
            Float.CFrame = root.CFrame * CFrame.new(0, FloatValue, 0)
            local function Cleanup()
                if FloatingFunc then FloatingFunc:Disconnect() end
                AutofarmIN = false
                Float:Destroy()
                if floatDied then floatDied:Disconnect() end
            end
            floatDied = pchar:FindFirstChildOfClass("Humanoid").Died:Connect(Cleanup)
            local function FloatPadLoop()
                local root = getRoot(pchar)
                if pchar:FindFirstChild(floatName) and root then
                    Float.CFrame = root.CFrame * CFrame.new(0, FloatValue, 0)
                else
                    Cleanup()
                end
            end
            FloatingFunc = RunService.Heartbeat:Connect(FloatPadLoop)
        end)
    end)
end

