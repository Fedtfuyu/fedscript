-- Lấy coin gần nhất (chế độ TP cũ)
local function GetNearestValidCoin(container)
    local character = Player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not hrp then return nil end
    local nearestCoin, minDistance = nil, math.huge
    for _, coin in pairs(container:GetChildren()) do
        if coin:GetAttribute("CoinID") == getgenv().config["CoinType"] and coin:FindFirstChild("TouchInterest") then
            local distance = (hrp.Position - coin.Position).Magnitude
            if distance < minDistance then
                minDistance = distance
                nearestCoin = coin
            end
        end
    end
    return nearestCoin
end

