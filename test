do
    local PlayerGuiTop = Players.LocalPlayer:WaitForChild("PlayerGui")

    local function isFullCandy()
        local candy = PlayerGuiTop.MainGUI.Game.CoinBags.Container.Candy
        if not candy.Visible then return false end

        local icon = candy:FindFirstChild("FullBagIcon")
        local iconOn = false
        if icon then
            local ok = pcall(function() iconOn = icon.Visible and ((icon.ImageTransparency or 0) < 1) end)
            if not ok then iconOn = false end
        end

        local node = candy:FindFirstChild("Full")
        local nodeOn = false
        if node then
            if node:IsA("TextLabel") or node:IsA("TextButton") then
                nodeOn = node.Visible and ((node.Text or ""):lower():find("full") ~= nil)
            elseif node:IsA("ImageLabel") or node:IsA("ImageButton") then
                nodeOn = node.Visible and ((node.ImageTransparency or 0) < 1)
            else
                nodeOn = node.Visible
            end
        end

        return iconOn or nodeOn
    end

    local function HopOnce(preferLowPop)
        local placeId = game.PlaceId
        local currentJob = game.JobId
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(placeId)
        local cursor = nil
        for _ = 1, 3 do
            local fullUrl = url .. (cursor and ("&cursor=" .. cursor) or "")
            local res = nil
            pcall(function()
                res = request({
                    Url = fullUrl,
                    Method = "GET",
                    Headers = {["Content-Type"] = "application/json"}
                })
            end)
            if res and res.StatusCode == 200 then
                local data = nil
                pcall(function() data = HttpService:JSONDecode(res.Body) end)
                if data and data.data and #data.data > 0 then
                    local candidates = {}
                    for _, srv in ipairs(data.data) do
                        if srv.playing < srv.maxPlayers and srv.id ~= currentJob then
                            table.insert(candidates, srv)
                        end
                    end
                    if #candidates > 0 then
                        if preferLowPop then
                            table.sort(candidates, function(a, b) return a.playing < b.playing end)
                        else
                            table.sort(candidates, function(a, b) return a.playing > b.playing end)
                        end
                        local chosen = candidates[1]
                        if chosen then
                            return TryTeleport(placeId, chosen.id)
                        end
                    end
                    cursor = data.nextPageCursor
                    if not cursor then break end
                else
                    break
                end
            else
                break
            end
        end
        return TryTeleport(placeId, nil)
    end

    local function HopServerLoop()
        if not getgenv().config["HopWhenFullBag"] then return true end
        local placeId = game.PlaceId
        local startJob = game.JobId
        warn("[Hop] Bắt đầu hop/rejoin vòng lặp cho tới khi đổi server...")

        while true do
            HopOnce(true)
            local t0 = tick()
            repeat task.wait(0.5) until game.JobId ~= startJob or (tick() - t0) > 20
            if game.JobId ~= startJob then
                warn("[Hop] Đã sang server mới: " .. tostring(game.JobId))
                break
            end
            task.wait(2)
            TryTeleport(placeId, nil)
            local t1 = tick()
            repeat task.wait(0.5) until game.JobId ~= startJob or (tick() - t1) > 20
            if game.JobId ~= startJob then
                warn("[Hop] Đã rejoin sang server mới: " .. tostring(game.JobId))
                break
            end
            task.wait(2)
        end
        return true
    end

    task.spawn(function()
        while task.wait(1) do
            local ok, full = pcall(isFullCandy)
            local FullBag = (ok and full) and true or false
            if FullBag and getgenv().config["HopWhenFullBag"] then
                warn("[Candy] Full bag → Bắt đầu hop/rejoin vòng lặp...")
                HopServerLoop()
                break
            end
        end
    end)
end
