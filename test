-- =========================
-- TP MỚI Octree – chỉ chạy khi USE_NEW_TP = true
-- =========================
if USE_NEW_TP then
    local Octree = loadstring(game:HttpGet("https://raw.githubusercontent.com/Sleitnick/rbxts-octo-tree/main/src/init.lua", true))()
    local rt = {} rt.__index = rt rt.octree = Octree.new()
    rt.RoundInProgress = false
    rt.Players = game.Players
    rt.player  = game.Players.LocalPlayer
    rt.coinContainer = nil
    rt.radius = 200
    rt.walkspeed = 30
    rt.touchedCoins = {}
    rt.positionChangeConnections = setmetatable({}, { __mode = "v" })
    rt.Added, rt.Removing, rt.UserDied = nil, nil, nil

    local State = { Action="Action", StandStillWait="StandStillWait", WaitingForRound="WaitingForRound",
                    WaitingForRoundEnd="WaitingForRoundEnd", RespawnState="RespawnState" }
    local CurrentState = State.WaitingForRound
    local LastPosition, BagIsFull, IsMurderer, Working = nil, false, false, false

    local okTimerPart = workspace:FindFirstChild("RoundTimerPart")
    local ROUND_TIMER = okTimerPart and okTimerPart:FindFirstChild("SurfaceGui") and okTimerPart.SurfaceGui:FindFirstChild("Timer")
    local PLAYER_GUI = Players.LocalPlayer:WaitForChild("PlayerGui")
    _G.__rt = rt; _G.__rt._alive = true

    function rt:Message(ti, tx, tm) pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", {Title=ti, Text=tx, Duration=tm}) end) end
    function rt:Character() return self.player.Character or self.player.CharacterAdded:Wait() end
    function rt:GetCharacterLoaded() repeat task.wait(0.02) until rt:Character() ~= nil end
    function rt:CheckIfPlayerIsInARound()
        if not PLAYER_GUI:FindFirstChild("MainGUI") then return false end
        local mg = PLAYER_GUI.MainGUI
        if mg.Game and mg.Game:FindFirstChild("Timer") and mg.Game.Timer.Visible then return true end
        if mg.Game and mg.Game:FindFirstChild("EarnedXP") and mg.Game.EarnedXP.Visible then return true end
        return false
    end
    function rt:MainGUI() return self.player.PlayerGui.MainGUI or self.player.PlayerGui:WaitForChild("MainGUI") end
    function rt.Disconnect(c) if c and c.Connected then c:Disconnect() end end
    function rt:Map()
        for _, v in workspace:GetDescendants() do
            if v.Name == "Spawns" and v.Parent.Name ~= "Lobby" then return v.Parent end
        end
        return nil
    end
    function rt:CheckIfGameInProgress() return rt:Map() and true or false end
    function rt:GetAlivePlayers()
        local aliveplrs = setmetatable({}, {__mode="v"})
        local OldPos = self:Character():GetPivot()
        local pos = CFrame.new(-121.995956, 134.462997, 46.4180717)
        if not rt:CheckIfGameInProgress() then return nil end
        local isAlive = rt:CheckIfPlayerIsInARound()
        if not isAlive then self:Character():PivotTo(pos) end
        for _, v in pairs(rt.Players:GetPlayers()) do
            if v.Character and v.Character.PrimaryPart and self:Character().PrimaryPart then
                local d = (self:Character().PrimaryPart.Position - v.Character.PrimaryPart.Position).Magnitude
                if isAlive then if d <= 500 then table.insert(aliveplrs, v) end
                else if d > 500 then table.insert(aliveplrs, v) end end
            end
        end
        if not isAlive then self:Character():PivotTo(OldPos) end
        return aliveplrs
    end
    function rt:CheckIfPlayerWasInARound() return self.player:GetAttribute("Alive") and true or false end
    function rt:IsElite() return self.player:GetAttribute("Elite") and true or false end

    local function AutoFarmCleanUp()
        if next(rt.positionChangeConnections) == nil then return end
        for _, c in pairs(rt.positionChangeConnections) do rt.Disconnect(c) end
        rt.Disconnect(rt.Added); rt.Disconnect(rt.Removing)
        table.clear(rt.touchedCoins); table.clear(rt.positionChangeConnections)
        rt.octree:ClearAllNodes()
    end
    local function isCoinTouched(coin) return rt.touchedCoins[coin] end
    local function markCoinAsTouched(coin)
        rt.touchedCoins[coin] = true
        local node = rt.octree:FindFirstNode(coin)
        if node then rt.octree:RemoveNode(node) end
    end
    local function setupTouchTracking(coin)
        local t = coin:FindFirstChildWhichIsA("TouchTransmitter")
        if t then
            local con; con = t.AncestryChanged:Connect(function(_, parent)
                if parent == nil then markCoinAsTouched(coin); rt.Disconnect(con) end
            end)
            rt.positionChangeConnections[coin] = con
        end
    end
    local function setupPositionTracking(coin, lastY)
        local con; con = coin:GetPropertyChangedSignal("Position"):Connect(function()
            local y = coin.Position.Y
            if lastY and lastY ~= y then
                markCoinAsTouched(coin)
                rt.Disconnect(con)
                pcall(function() coin:Destroy() end)
            end
        end)
        rt.positionChangeConnections[coin] = con
    end
    local function moveToPositionSlowly(target, duration)
        local start = rt:Character().PrimaryPart.Position
        local startTime = tick()
        local nearestNode = rt.octree:GetNearest(rt:Character().PrimaryPart.Position, rt.radius, 1)[1]
        if nearestNode then
            local closestCoin = nearestNode.Object
            if not isCoinTouched(closestCoin) then
                local t2 = closestCoin.Position
                if target ~= t2 then target = t2 end
            end
        end
        while true do
            local a = math.min((tick() - startTime) / duration, 1)
            if rt:Character() == nil then break end
            rt:Character():PivotTo(CFrame.new(start:Lerp(target, a)))
            if a >= 1 then task.wait(0.2) break end
            task.wait()
        end
    end
    local function populateOctree()
        rt.octree:ClearAllNodes()
        if not rt.coinContainer then return end
        for _, d in pairs(rt.coinContainer:GetDescendants()) do
            if d:IsA("TouchTransmitter") then
                local coin = d.Parent
                if not isCoinTouched(coin) then
                    rt.octree:CreateNode(coin.Position, coin)
                    setupTouchTracking(coin)
                end
                setupPositionTracking(coin, coin.Position.Y)
            end
        end
        rt.Added = rt.coinContainer.DescendantAdded:Connect(function(d)
            if d:IsA("TouchTransmitter") then
                local coin = d.Parent
                if not isCoinTouched(coin) then
                    rt.octree:CreateNode(coin.Position, coin)
                    setupTouchTracking(coin)
                    setupPositionTracking(coin, coin.Position.Y)
                end
            end
        end)
        rt.Removing = rt.coinContainer.DescendantRemoving:Connect(function(d)
            if d:IsA("TouchTransmitter") and d.Parent.Name == "Coin_Server" then
                local coin = d.Parent
                if isCoinTouched(coin) then
                    markCoinAsTouched(coin)
                end
            end
        end)
    end
    local function ChangeState(s) CurrentState = s end
    local function CheckMurderer() return IsMurderer end
    local function IsBagFull() return false end -- full bag do watcher Candy xử lý Hop

    local function CollectCoins()
        Working = true
        local map = rt:Map(); if not map then Working=false return end
        rt.coinContainer = map:FindFirstChild("CoinContainer"); if not rt.coinContainer then Working=false return end
        populateOctree()
        while CurrentState == State.Action do
            if IsBagFull() then
                BagIsFull = true; break
            end
            if rt:Character() == nil then break end
            local nearest = rt.octree:GetNearest(rt:Character().PrimaryPart.Position, rt.radius, 1)[1]
            if nearest then
                local coin = nearest.Object
                if not isCoinTouched(coin) then
                    local target = coin.Position
                    local dur = (rt:Character().PrimaryPart.Position - target).Magnitude / rt.walkspeed
                    moveToPositionSlowly(target, dur)
                    markCoinAsTouched(coin)
                    task.wait(0.2)
                end
            else
                task.wait(1)
            end
        end
        AutoFarmCleanUp()
    end
    local function RespawnState()
        rt:GetCharacterLoaded(); task.wait(1)
        if LastPosition == nil then
            local list = rt:GetAlivePlayers()
            if list and list[1] and list[1].Character and list[1].Character.PrimaryPart then
                LastPosition = list[1].Character:GetPivot()
            end
        end
        if rt:Character() then
            rt:GetCharacterLoaded()
            if LastPosition then rt:Character():PivotTo(LastPosition) end
        end
        if not rt.RoundInProgress then ChangeState(State.WaitingForRound) return end
        ChangeState(State.Action)
    end
    local function WaitingForRound()
        Working = false
        repeat task.wait(0.5) until rt.RoundInProgress and rt:CheckIfPlayerWasInARound()
        ChangeState(State.Action)
    end
    local function waitForRoundEnd()
        Working = false
        repeat task.wait(1) until not rt.RoundInProgress
        ChangeState(State.WaitingForRound)
    end
    local function StandStillWait()
        ChangeState("Nothing"); rt:GetCharacterLoaded(); task.wait(2)
        ChangeState(State.WaitingForRound)
    end

    rt.RoleTracker1 = rt.player.DescendantAdded:Connect(function(d)
        if d:IsA("Tool") and d.Name == "Knife" then IsMurderer = true end
    end)
    rt.InvalidPos = workspace.DescendantAdded:Connect(function(d)
        if d:IsA("Model") then
            if string.match(d.Name, "Glitch") and d.Parent.Name ~= "Lobby" then d:Destroy() end
            if string.match(d.Name, "Invis")  and d.Parent.Name ~= "Lobby" then d:Destroy() end
        end
    end)
    if ROUND_TIMER then
        ROUND_TIMER:GetPropertyChangedSignal("Text"):Connect(function()
            rt.RoundInProgress = true
        end)
    end
    local PLAYER_GUI2 = Players.LocalPlayer:WaitForChild("PlayerGui")
    PLAYER_GUI2.ChildAdded:Connect(function(child)
        if child:IsA("Sound") then
            rt.RoundInProgress = false; Working = false; ChangeState(State.WaitingForRound)
        end
    end)
    rt.UserDied = rt.player.CharacterRemoving:Connect(function()
        local LastText = ROUND_TIMER and ROUND_TIMER.Text or ""
        if CheckMurderer() then IsMurderer=false; LastPosition=nil; Working=false; rt.RoundInProgress=false; return ChangeState(State.StandStillWait) end
        if not rt.RoundInProgress then IsMurderer=false; LastPosition=nil; Working=false; return ChangeState(State.WaitingForRound) end
        task.wait(2)
        if ROUND_TIMER and LastText == ROUND_TIMER.Text then
            LastPosition=nil; IsMurderer=false; rt.RoundInProgress=false; Working=false
            return ChangeState(State.WaitingForRound)
        end
        if Working then Working=false; IsMurderer=false; LastPosition=nil; ChangeState(State.RespawnState) end
    end)
    IsMurderer = rt.player.Backpack:FindFirstChild("Knife") and true or false

    task.spawn(function()
        while USE_NEW_TP do
            if CurrentState == State.WaitingForRound then
                WaitingForRound()
            elseif CurrentState == State.Action then
                CollectCoins()
                if BagIsFull or not rt.RoundInProgress then
                    if CheckMurderer() then
                        BagIsFull, Working, rt.RoundInProgress = false, false, false
                        pcall(function() rt:Character():FindFirstChildWhichIsA("Humanoid"):ChangeState(Enum.HumanoidStateType.Dead) end)
                    else
                        BagIsFull, Working = false, false
                        pcall(function() rt:Character():FindFirstChildWhichIsA("Humanoid"):ChangeState(Enum.HumanoidStateType.Dead) end)
                        ChangeState(State.WaitingForRoundEnd)
                    end
                end
            elseif CurrentState == State.WaitingForRoundEnd then
                waitForRoundEnd()
            elseif CurrentState == State.RespawnState then
                RespawnState()
            elseif CurrentState == State.StandStillWait then
                StandStillWait()
            end
            task.wait()
        end
    end)
end

