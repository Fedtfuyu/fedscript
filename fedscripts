local function findContainer()
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") then
            local c = v:FindFirstChild("CoinContainer")
            if c then return c end
        end
    end
end

local function getCoins(c)
    local list = {}
    if not c then return list end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") and d.Name == "Coin_Server" then
            if d:FindFirstChildOfClass("TouchTransmitter") or d:FindFirstChild("TouchInterest") then
                table.insert(list, d)
            end
        end
    end
    return list
end

local function nearestCoin(pos, coins)
    local best, dist = nil, math.huge
    for _, c in ipairs(coins) do
        if c and c.Parent then
            local d = (pos - c.Position).Magnitude
            if d < dist then best, dist = c, d end
        end
    end
    if not best or dist > RADIUS then return nil end
    return best
end

-- >>> TWEEN CHUẨN: thời gian = quãng đường / Farm_Delay (coi Farm_Delay là “tốc độ”)
local function tweenTo(pos, coin)
    if not (HRP and HRP.Parent) then return end
    local d = (HRP.Position - pos).Magnitude
    local spd = tonumber(getgenv().Config.Farm_Delay) or 32
    if spd <= 0 then spd = 32 end
    local t = d / spd
    local tw = TweenService:Create(HRP, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})

    local gone = false
    local conn = coin and coin.AncestryChanged:Connect(function(_, p)
        if not p then gone = true tw:Cancel() end
    end)

    setNoclip(true)
    pcall(function() tw:Play() end)

    local done = false
    tw.Completed:Connect(function() done = true end)
    local s = os.clock()
    while not done do
        if gone or not HRP.Parent or os.clock() - s > t + 1 then
            tw:Cancel()
            break
        end
        RunService.Heartbeat:Wait()
    end

    if conn then conn:Disconnect() end
    setNoclip(false)
end
-- <<< END TWEEN

task.spawn(function()
    while task.wait(LOOP_DELAY) do
        if not (HRP and HRP.Parent) then
            if Player.Character then HRP = Player.Character:FindFirstChild("HumanoidRootPart") else continue end
        end
        local cont = findContainer(); if not cont then continue end
        local coins = getCoins(cont); if #coins == 0 then continue end
        local coin = nearestCoin(HRP.Position, coins); if not coin then continue end
        tweenTo(coin.Position, coin)
        task.wait(TOUCH_DELAY)
    end
end)

