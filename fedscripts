local floatName = "FloatPlatform"
local function getRoot(char) return char and char:FindFirstChild("HumanoidRootPart") end

local FloatingFunc, floatDied, Noclipping
local function onnoclip()
    if Noclipping then return end
    Noclipping = RunService.Stepped:Connect(function()
        local ch = LocalPlayer.Character
        if not ch then return end
        for _, child in pairs(ch:GetDescendants()) do
            if child:IsA("BasePart") and child.CanCollide == true and child.Name ~= floatName then
                child.CanCollide = false
            end
        end
    end)
end

local function CreateFloatPlatform()
    pcall(function()
        local pchar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        if pchar:FindFirstChild(floatName) then return end
        onnoclip()
        task.spawn(function()
            local Float = Instance.new("Part")
            Float.Name = floatName
            Float.Parent = pchar
            Float.Transparency = 1
            Float.Size = Vector3.new(2, 0.2, 1.5)
            Float.Anchored = true
            local FloatValue = -2.8
            local root = getRoot(pchar); if not root then return end
            Float.CFrame = root.CFrame * CFrame.new(0, FloatValue, 0)

            local function Cleanup()
                if FloatingFunc then FloatingFunc:Disconnect() end
                if floatDied    then floatDied:Disconnect() end
                pcall(function() Float:Destroy() end)
            end
            floatDied = pchar:FindFirstChildOfClass("Humanoid").Died:Connect(Cleanup)
            FloatingFunc = RunService.Heartbeat:Connect(function()
                local r = getRoot(pchar)
                if r and Float and Float.Parent then
                    Float.CFrame = r.CFrame * CFrame.new(0, FloatValue, 0)
                else
                    Cleanup()
                end
            end)
        end)
    end)
end

-- ===== HOP/REJOIN helper (ƯU TIÊN SERVER ĐÔNG NGƯỜI) =====
local function TryTeleport(placeId, jobId)
    local ok, err = pcall(function()
        if jobId then
            TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
        else
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    end)
    if not ok and err then warn("[Teleport] " .. tostring(err)) end
    return ok
end

local function HopOncePreferCrowded()
    local placeId = game.PlaceId
    local currentJob = game.JobId
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(placeId)
    local cursor = nil
    for _ = 1, 3 do
        local fullUrl = url .. (cursor and ("&cursor=" .. cursor) or "")
        local res = nil
        pcall(function()
            res = request({ Url = fullUrl, Method = "GET", Headers = {["Content-Type"]="application/json"} })
        end)
        if res and res.StatusCode == 200 then
            local data = nil
            pcall(function() data = HttpService:JSONDecode(res.Body) end)
            if data and data.data and #data.data > 0 then
                local candidates = {}
                for _, srv in ipairs(data.data) do
                    if srv.playing < srv.maxPlayers and srv.id ~= currentJob then
                        table.insert(candidates, srv)
                    end
                end
                if #candidates > 0 then
                    table.sort(candidates, function(a, b) -- ƯU TIÊN ĐÔNG NGƯỜI
                        return a.playing > b.playing
                    end)
                    local chosen = candidates[1]
                    if chosen then return TryTeleport(placeId, chosen.id) end
                end
                cursor = data.nextPageCursor
                if not cursor then break end
            else break end
        else break end
    end
    return TryTeleport(placeId, nil)
end

local function HopServerLoopPreferCrowded()
    local placeId = game.PlaceId
    local startJob = game.JobId
    warn("[Hop] Bắt đầu hop/rejoin vòng lặp (ưu tiên server đông người) cho tới khi đổi server...")

    while true do
        HopOncePreferCrowded()
        local t0 = tick()
        repeat task.wait(0.5) until game.JobId ~= startJob or (tick() - t0) > 20
        if game.JobId ~= startJob then
            warn("[Hop] Đã sang server mới: " .. tostring(game.JobId))
            break
        end
        task.wait(2)
        TryTeleport(placeId, nil)
        local t1 = tick()
        repeat task.wait(0.5) until game.JobId ~= startJob or (tick() - t1) > 20
        if game.JobId ~= startJob then
            warn("[Hop] Đã rejoin sang server mới: " .. tostring(game.JobId))
            break
        end
        task.wait(2)
    end
    return true
end

